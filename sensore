<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <title>Sensore ID</title>
</head>
<body>
  <script>
    const params = new URLSearchParams(window.location.search);
    const currentId = params.get('id');
    const previousId = localStorage.getItem('nuovo_terremoto_id');

    if (currentId) {
      // Se c'è già un ID salvato ed è diverso dal nuovo -> aggiorna localStorage!
      if (previousId && currentId !== previousId) {
        localStorage.setItem('nuovo_terremoto_id', currentId);
      } else if (!previousId) {
        // Primo avvio dell'app: salva l'ID iniziale senza far suonare
        localStorage.setItem('nuovo_terremoto_id', currentId);
      }
    }
  </script>
</body>
</html>
